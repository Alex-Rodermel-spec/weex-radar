//@version=6
// WEEX RADAR - selected 16 WEEX perpetuals, 1-minute Early WATCH only.
// One chart (1m) can display the 16-market scanner and issue ONE TradingView
// "Any alert() function call" alert. This is NOT an order or a 5m confirmation.
// The independent WEEX RADAR backend keeps sending ntfy without TradingView.
// Missing TradingView tickers are shown as NO DATA, never replaced by other exchanges.
indicator("WEEX RADAR · Early 1m · 16 Coins", overlay = true, dynamic_requests = true)

fastLength = input.int(20, "EMA fast (1m)", minval = 5, maxval = 100)
slowLength = input.int(50, "EMA slow (1m)", minval = 20, maxval = 200)
breakoutLength = input.int(12, "Prior 1m candles", minval = 5, maxval = 40)
volumeRatio = input.float(1.15, "Minimum volume / average", minval = 1.0, maxval = 5.0, step = 0.05)
maxWick = input.float(0.35, "Max rejection wick / range", minval = 0.05, maxval = 0.80, step = 0.05)
showTable = input.bool(true, "Show 16-coin table")

// Identical symbol universe to api/signals.mjs. Each pair consumes two
// request.security contexts: 16 x 1m + 16 x 15m = 32 (< standard 40 limit).
var array<string> symbols = array.from(
     "WEEX:BTCUSDT.P", "WEEX:ETHUSDT.P", "WEEX:XRPUSDT.P", "WEEX:SOLUSDT.P",
     "WEEX:ALGOUSDT.P", "WEEX:1000SHIBUSDT.P", "WEEX:DOGEUSDT.P", "WEEX:XAUTUSDT.P",
     "WEEX:ZECUSDT.P", "WEEX:1000PEPEUSDT.P", "WEEX:HYPEUSDT.P", "WEEX:BNBUSDT.P",
     "WEEX:ADAUSDT.P", "WEEX:LINKUSDT.P", "WEEX:SUIUSDT.P", "WEEX:AVAXUSDT.P")
var array<string> names = array.from(
     "BTC", "ETH", "XRP", "SOL", "ALGO", "1000SHIB", "DOGE", "XAUT",
     "ZEC", "1000PEPE", "HYPE", "BNB", "ADA", "LINK", "SUI", "AVAX")

// Unlike barstate.isconfirmed inside request.security (unsupported), [1]
// with lookahead_on reads only the last COMPLETED 1-minute candle.
f_minuteSignal() =>
    float emaFast = ta.ema(close, fastLength)
    float emaSlow = ta.ema(close, slowLength)
    float atr = ta.atr(14)
    float rsi = ta.rsi(close, 14)
    float avgVolume = ta.sma(volume, 20)
    float upper = ta.highest(high[1], breakoutLength)
    float lower = ta.lowest(low[1], breakoutLength)
    float candleRange = high - low
    float upperWick = candleRange > 0 ? (high - close) / candleRange : 1.0
    float lowerWick = candleRange > 0 ? (close - low) / candleRange : 1.0
    bool volumeOk = not na(avgVolume) and avgVolume > 0 and volume >= avgVolume * volumeRatio
    bool rangeOk = atr > 0 and candleRange <= 2.6 * atr
    bool upBreak = ta.crossover(close, upper)
    bool downBreak = ta.crossunder(close, lower)
    bool longWatch = emaFast > emaSlow and upBreak and rsi >= 52 and rsi <= 72 and volumeOk and rangeOk and upperWick <= maxWick and (close - emaFast) <= 2.6 * atr
    bool shortWatch = emaFast < emaSlow and downBreak and rsi >= 28 and rsi <= 48 and volumeOk and rangeOk and lowerWick <= maxWick and (emaFast - close) <= 2.6 * atr
    int direction = longWatch ? 1 : shortWatch ? -1 : 0
    [direction[1], close[1], time_close[1]]

// The 15m trend also uses only its last COMPLETED candle.
f_trend15() =>
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    close[1] > e20[1] and e20[1] > e50[1] ? 1 : close[1] < e20[1] and e20[1] < e50[1] ? -1 : 0

bool onMinuteChart = timeframe.isminutes and timeframe.multiplier == 1
var table board = table.new(position.top_right, 4, 17, border_width = 1)
varip array<int> alerted = array.new_int(16, 0)
string pending = ""

for i = 0 to 15
    string symbol = array.get(symbols, i)
    string name = array.get(names, i)
    [minuteDirection, minutePrice, candleClose] = request.security(symbol, "1", f_minuteSignal(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 250)
    int trend15 = request.security(symbol, "15", f_trend15(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 250)
    bool hasData = not na(minuteDirection) and not na(minutePrice) and not na(candleClose) and not na(trend15)
    bool fresh = hasData and timenow >= candleClose and timenow - candleClose <= 45000
    int direction = hasData and fresh and minuteDirection != 0 and minuteDirection == trend15 ? minuteDirection : 0
    string status = not hasData ? "NO DATA" : direction == 1 ? "LONG WATCH" : direction == -1 ? "SHORT WATCH" : "WAIT"
    color statusColor = direction == 1 ? color.new(color.green, 65) : direction == -1 ? color.new(color.red, 65) : color.new(color.gray, 82)
    string priceText = hasData ? str.tostring(minutePrice, "#.########") : "-"
    string closeText = hasData ? str.format_time(candleClose, "HH:mm:ss", "Europe/Berlin") : "-"

    if onMinuteChart and barstate.isrealtime and direction != 0 and array.get(alerted, i) != candleClose
        string side = direction == 1 ? "LONG" : "SHORT"
        pending += name + " " + side + " · цена " + priceText + " · свеча " + closeText + "\n"
        array.set(alerted, i, candleClose)

    if barstate.islast and showTable
        if i == 0
            table.cell(board, 0, 0, "WEEX 1m", text_color = color.white, bgcolor = color.new(color.blue, 45), text_size = size.tiny)
            table.cell(board, 1, 0, "WATCH", text_color = color.white, bgcolor = color.new(color.blue, 45), text_size = size.tiny)
            table.cell(board, 2, 0, "Цена", text_color = color.white, bgcolor = color.new(color.blue, 45), text_size = size.tiny)
            table.cell(board, 3, 0, "Свеча", text_color = color.white, bgcolor = color.new(color.blue, 45), text_size = size.tiny)
        table.cell(board, 0, i + 1, name, text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.tiny)
        table.cell(board, 1, i + 1, status, text_color = color.white, bgcolor = statusColor, text_size = size.tiny)
        table.cell(board, 2, i + 1, priceText, text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.tiny)
        table.cell(board, 3, i + 1, closeText, text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.tiny)

if barstate.isrealtime and str.length(pending) > 0
    alert("⚡ WEEX RADAR EARLY WATCH · 1m\n" + pending + "ЖДАТЬ 5m подтверждения! НЕ ОТКРЫВАТЬ СДЕЛКУ.", alert.freq_all)

// This script never touches WEEX APIs, login credentials, Vercel or trade orders.
// The user must install it and create one "Any alert() function call" TradingView
// alert manually; GitHub updates do NOT sync into a saved TradingView indicator.
